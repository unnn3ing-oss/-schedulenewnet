{
  "_meta": {
    "source": "https://digi-social-post.tvbs.ai/ip/newsnet/",
    "extracted": "2026-10-25",
    "note": "由前端 inline script 與 /shared/queen-sdk.js 讀出，僅含設定常數，不含任何憑證"
  },
  "ip": {
    "name": "newsnet",
    "label": "網新",
    "canvas": [1080, 1080],
    "minLeadMinutes": 20,
    "defaultLeadMinutes": 30,
    "chunkBytes": 8388608,
    "maxVideoBytes": 4294967296,
    "wordmark": "wordmark_newsnet.png",
    "textCard": { "font": "hanwang", "shadow": true, "line_gap": 1.45, "center_on_canvas": true },
    "videoHashtag": "#焦點新聞影音都在TVBS"
  },
  "pages": [
    { "code": "news",     "label": "新聞",   "fb": "TVBS新聞",   "utm": "utm_source=facebook&utm_medium=fbarticlepic",       "rd": "主粉" },
    { "code": "ent",      "label": "娛樂",   "fb": "TVBS娛樂",   "utm": "utm_source=facebook&utm_medium=tvbsteatimenewspic", "rd": "娛樂粉" },
    { "code": "shaokang", "label": "少康",   "fb": "少康戰情室", "utm": "utm_source=facebook&utm_medium=2100roompic",        "rd": "少康粉" },
    { "code": "jkk",      "label": "擠看看", "fb": "擠看看",     "utm": "utm_source=facebook&utm_medium=gkkcomments",        "rd": "" },
    { "code": "intl",     "label": "國際＋", "fb": "TVBS國際+",  "utm": "utm_source=facebook&utm_medium=tvbspluspic",        "rd": "國際＋粉" },
    { "code": "weather",  "label": "氣象",   "fb": "TVBS氣象",   "utm": "utm_source=Facebook&utm_medium=18weather",          "rd": "" }
  ],
  "layouts": {
    "newsnet_news":     { "frame": "square", "limits": [15, 15, 15], "canvas": [1080, 1080] },
    "newsnet_ent":      { "frame": "square", "limits": [15, 15, 15], "canvas": [1080, 1080] },
    "newsnet_shaokang": { "frame": "square", "limits": [15, 15, 15], "canvas": [1080, 1080] },
    "newsnet_jkk":      { "frame": "square", "limits": [15, 15, 15], "canvas": [1080, 1080] },
    "newsnet_intl":     { "frame": "wide",   "limits": [10, 16, 16], "canvas": [1200, 675] }
  },
  "frameDisplaySize": { "square": [300, 300], "wide": [400, 225] },
  "textCardStyles": [
    { "key": "flash", "label": "快訊紅", "bg": "#b00020", "fg": "#ffffff" },
    { "key": "intl",  "label": "國際藍", "bg": "#0d2b6b", "fg": "#ffffff" },
    { "key": "wx",    "label": "氣象青", "bg": "#0a6e7c", "fg": "#ffffff" },
    { "key": "life",  "label": "生活橘", "bg": "#c46a1a", "fg": "#ffffff" },
    { "key": "night", "label": "深夜黑", "bg": "#111111", "fg": "#ffffff" },
    { "key": "money", "label": "財經綠", "bg": "#0f5132", "fg": "#ffffff" },
    { "key": "mocha", "label": "咖啡灰", "bg": "#5a5448", "fg": "#ffffff" }
  ],
  "api": {
    "auth": "same-origin cookie（fetch credentials: same-origin）",
    "endpoints": {
      "POST /render_text_card": "純文字底圖成圖 → PNG blob",
      "POST /render":           "套版（作圖框）成圖 → PNG blob",
      "POST /render_text":      "舊版純文字（SDK 有、本頁未用）",
      "POST /render_collage":   "拼圖（SDK 有、本頁未用）",
      "GET  /hero?url=":        "SDK：由文章網址抓主圖 → { hero }",
      "GET  /page_meta?url=":   "本頁：帶入標題／og:image",
      "POST /ai_caption":       "body: { ip, mode: generate|proofread, ... }",
      "POST /guard/check":      "AI 社群守則判讀 body: { ip, title_lines, caption, text }",
      "GET  /video/cover?name=": "影片封面（含 token 流程）",
      "PUT  <upload_url>":      "影片 resumable 分段上傳（Content-Range，8MiB/段）",
      "POST /schedule":         "排程，payload 見 payload.schedule",
      "POST /publish":          "立即發布，回 { message | post_url | post_id }"
    }
  },
  "payload": {
    "base": {
      "ip": "newsnet",
      "mode": "text_card | single | video",
      "template": "frame 模式才有，值為 layouts 的 key；其餘為空字串",
      "image_url": "frame 模式：主圖網址",
      "crop": "frame 模式：取景框座標，否則 null",
      "line1": "", "line2": "", "title_lines": [],
      "caption": "小編文（影音模式會組成【標題】+小編一句+hashtag）",
      "article_id": "由文章網址以 /(\\d{6,8})(?:[/?#]|$)/ 取出；影音模式為空",
      "short_title": "手動填，否則取標題第一行去空白後前 5 字",
      "rd_write": true,
      "guard": { "check_id": "", "level": "green|yellow|red", "ack": false }
    },
    "text_card_extra": ["text", "bg", "text_color", "width", "height", "wordmark", "font", "shadow", "line_gap", "center_on_canvas"],
    "video_extra": ["video_name", "cover_file_id", "video_type(newsnet|sot)", "video_mode(native)", "youtube_url", "video_url(drive 連結)"],
    "schedule": {
      "page": "<pages.code>",
      "link": "文章網址 + 該粉專 utm（已含同參數則不重複附加；影音模式為空）",
      "schedule": "立即發布為空字串；排程為 'YYYY-MM-DDTHH:mm'"
    }
  },
  "rules": [
    "排程時間需晚於按下當下 ≥ 20 分鐘；勾粉專時預填 現在+30 分",
    "每個粉專各送一次請求（payload 加 page、link、schedule），失敗只重送失敗的台",
    "送出前先跑 /guard/check；red 必須 ack=true 才能送；內容被改過要重判",
    "rd 欄位為空的粉專（擠看看、氣象）不寫 RD；rd_write=false 則整篇不寫",
    "RD 回填以「粉專 + 發文時間」定位格子，寫入 文章ID/圖文/短標（純文字＝文字；網新影片＝reels/短標；SOT＝純影/短標）",
    "影片類型必須手選（newsnet / sot），無預設；影音一律原生影片，不做 YouTube 連結貼文",
    "追蹤碼規則：氣象保留大寫 Facebook"
  ],
  "unknown_needs_confirm": [
    "各 POST 的回應錯誤格式（niceError 會解析 detail/message/error）",
    "/video/cover 與影片上傳 token 的完整流程（未讀完）",
    "RD（試算表/DB）實際寫入位置與驗證方式，前端只看到 rd_write 旗標，寫入應在後端",
    "/hub 上其他 IP 的設定（本次只抓網新）"
  ]
}
