{
  "manifest_version": 3,
  "name": "網新快速排程 連線驗證",
  "version": "0.8.3",
  "description": "讓 GitHub Pages 介面透過外掛帶著網新後台的登入 cookie 呼叫 API（白名單端點：帶入、預覽、AI 小編文、守則判讀、排程與發布）。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "網新快速排程：開啟側邊欄",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "cookies",
    "scripting",
    "declarativeNetRequest",
    "sidePanel",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://digi-social-post.tvbs.ai/*",
    "https://unnn3ing-oss.github.io/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*.tvbs.com.tw/*",
    "https://tvbs.com.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://unnn3ing-oss.github.io/-schedulenewnet/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
